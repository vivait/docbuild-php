{
  "name": "vivait/docbuild-php",
  "license": "MIT",
  "description": "PHP client for doc.build",
  "authors": [
    {
      "name": "Viva IT",
      "email": "helpdesk@vivait.co.uk"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "psr/http-message": "^1.0 || ^2.0",
    "ext-json": "*",
    "symfony/http-client": "^6.4",
    "symfony/mime": "^6.4"
  },
  "require-dev": {
    "vimeo/psalm": "^6"
  },
  "config": {
    "bin-dir": "bin"
  },
  "autoload": {
    "psr-4": {
      "Vivait\\DocBuild\\": "src/Vivait/DocBuild/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Vivait\\DocBuild\\": "tests/"
    }
  }
}
